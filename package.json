{
  "name": "mkdocs-table-editor",
  "displayName": "MkDocs Table Editor",
  "description": "Visual editor for neoteroi.spantable Markdown tables in MkDocs Material",
  "version": "0.1.0",
  "publisher": "mkdocs-table-editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramsesyok/mkdocs-table-editor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tableEditor.open",
        "title": "Open Table Editor",
        "category": "Table Editor"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tableEditor.open",
          "when": "editorTextFocus && resourceExtname == .md",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build",
    "build": "npm run build:ext && npm run build:webview",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "test": "vitest run",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
